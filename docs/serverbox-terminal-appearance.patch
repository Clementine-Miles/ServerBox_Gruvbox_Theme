-  /// The terminal's own theme setting, falling back to the app's and then to
-  /// what the system asked for.
+  static TerminalAppearance appearanceOf(BuildContext context) =>
+      TerminalAppearance.resolve(
+        Stores.setting.termTheme.fetch(),
+        Theme.of(context).brightness,
+      );
+
   static bool isDark(BuildContext context) =>
-      switch (Stores.setting.termTheme.fetch()) {
-        TerminalThemeMode.light => false,
-        TerminalThemeMode.dark => true,
-        TerminalThemeMode.followApp => context.isDark,
-      };
-
-  static TerminalTheme themeOf(BuildContext context) {
-    final theme = isDark(context) ? TerminalThemes.dark : TerminalThemes.light;
-    return theme.copyWith(selectionCursor: UIs.primaryColor);
+      appearanceOf(context).brightness == Brightness.dark;
+
+  static TerminalTheme themeOf(BuildContext context) =>
+      appearanceOf(context).theme;
+}
+
+/// Resolves the whole terminal, including the surface under its virtual keys.
+final class TerminalAppearance {
+  const TerminalAppearance._(this.brightness, this.theme);
+
+  final Brightness brightness;
+  final TerminalTheme theme;
+
+  /// Optional profiles are full xterm themes, independent of the app palette.
+  static TerminalAppearance resolve(
+    TerminalThemeMode mode,
+    Brightness appBrightness, {
+    TerminalTheme light = TerminalThemes.light,
+    TerminalTheme dark = TerminalThemes.dark,
+  }) {
+    final brightness = switch (mode) {
+      TerminalThemeMode.light => Brightness.light,
+      TerminalThemeMode.dark => Brightness.dark,
+      TerminalThemeMode.followApp => appBrightness,
+    };
+    return TerminalAppearance._(
+      brightness,
+      brightness == Brightness.dark ? dark : light,
+    );
   }
+
+  Color keyColor({bool armed = false}) =>
+      armed ? theme.selectionCursor : theme.foreground;
+
+  Color get keyHoverColor => theme.foreground.withValues(alpha: .08);
+  Color get keyPressColor => theme.foreground.withValues(alpha: .10);
 }
 
